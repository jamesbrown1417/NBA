## Filtered Bets

```{r}
renderDT({
  df <- filtered_data() |>
    select(
      game_date,
      match,
      player_name,
      market_name,
      line,
      over_agency,
      under_agency,
      margin,
      outcome,
      over_price,
      under_price,
      over_profit,
      under_profit,
      total_profit
    ) |>
    arrange(desc(game_date), desc(margin))

  validate(need(nrow(df) > 0, "No rows match current filters."))

  datatable(
    df,
    rownames = FALSE,
    extensions = "Buttons",
    options = list(
      pageLength = 20,
      scrollX = TRUE,
      dom = "Bfrtip",
      buttons = c("copy", "csv")
    )
  ) |>
    formatRound(c("line", "margin", "over_price", "under_price", "over_profit", "under_profit", "total_profit"), 2)
})
```

